{
	"name": "obsidian-omnisearch-mcp",
	"version": "2.2.0",
	"description": "Search a live Obsidian vault through Omnisearch MCP with verified PDF and Markdown result opening.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "jest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"use-local-host": "mkdir -p .local && npm pack ../obsidian-local-rest-api --pack-destination .local && npm install --save-dev ./.local/obsidian-local-rest-api-*.tgz"
	},
	"keywords": [],
	"author": "黃鼎鈞",
	"license": "MIT",
	"dependencies": {
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@types/express": "^4.17.21",
		"@types/jest": "^29",
		"@types/node": "^22",
		"@types/supertest": "^6.0.2",
		"esbuild": "0.28.0",
		"express": "^4.21.2",
		"jest": "^29",
		"obsidian": "^1.13.1",
		"obsidian-local-rest-api": "^5.3.0",
		"supertest": "^7.0.0",
		"ts-jest": "^29",
		"tslib": "2.4.0",
		"typescript": "^5.9.3"
	}
}
